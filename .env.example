NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Só no servidor (nunca com prefixo NEXT_PUBLIC_)
# Supabase → Project Settings → API Keys → Secret key
SUPABASE_SECRET_KEY=
# Apify Console → Settings → API & Integrations
APIFY_TOKEN=
# Google AI Studio → Get API key, plano gratuito (escreve a mensagem do botão WhatsApp)
GEMINI_API_KEY=
# Google Cloud → APIs e serviços → ative "PageSpeed Insights API" → Credenciais →
# Criar chave de API. Gratuita. Sem ela, a análise de site funciona, mas não mede
# a velocidade no celular.
PAGESPEED_API_KEY=
# Webhook do Apify: URL pública do app (ex.: https://leads.vercel.app) e um
# segredo aleatório. Sem isso, a busca termina pela tela (sincronização a cada 5 s).
APP_URL=
APIFY_WEBHOOK_SECRET=
